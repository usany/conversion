{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview --port 3000",
    "lint": "deno run -A npm:@biomejs/biome check .",
    "format": "deno run -A npm:@biomejs/biome check --write .",
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest",
    "test:e2e": "deno run -A npm:playwright test",
    "storybook": "deno run -A npm:storybook dev -p 6006",
    "build-storybook": "deno run -A npm:storybook build"
  },
  "imports": {
    "@/": "./",
    "@biomejs/biome": "npm:@biomejs/biome@^2.5.5",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4",
    "@dnd-kit/core": "npm:@dnd-kit/core@^6.3.1",
    "@dnd-kit/sortable": "npm:@dnd-kit/sortable@^10.0.0",
    "@dnd-kit/utilities": "npm:@dnd-kit/utilities@^3.2.2",
    "@playwright/test": "npm:@playwright/test@^1.62.0",
    "@storybook/addon-a11y": "npm:@storybook/addon-a11y@^9",
    "@storybook/addon-docs": "npm:@storybook/addon-docs@^9",
    "@storybook/react-vite": "npm:@storybook/react-vite@^9",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.3.3",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.20",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^7.0.0",
    "@testing-library/react": "npm:@testing-library/react@^16.3.2",
    "@testing-library/user-event": "npm:@testing-library/user-event@^14.6.1",
    "@types/react": "npm:@types/react@^19.2.17",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@types/sanitize-html": "npm:@types/sanitize-html@^2.16.1",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.0.0",
    "html2pdf.js": "npm:html2pdf.js@^0.14.0",
    "dompurify": "npm:dompurify@^3.2.6",
    "jsdom": "npm:jsdom@^25.0.0",
    "marked": "npm:marked@^18.0.7",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-router-dom": "npm:react-router-dom@^6.24.0",
    "sanitize-html": "npm:sanitize-html@^2.17.6",
    "storybook": "npm:storybook@^9",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^7.0.0",
    "vitest": "npm:vitest@^2.1.0",
    "zod": "npm:zod@^4.4.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "types": ["vite/client", "vitest/globals"]
  }
}
